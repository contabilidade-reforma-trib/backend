<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Praxis.Modules\Praxis.Modules.csproj" />
    <ProjectReference Include="..\Praxis.Shared\Praxis.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Por padrão o publish leva o appsettings.Development.json junto, e ele
      carrega as credenciais locais. O .dockerignore já o mantém fora da imagem,
      mas cortar aqui garante que nenhum publish o carregue, seja qual for a
      forma de empacotar. Segredo em produção vem de variável de ambiente.
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
